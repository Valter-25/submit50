#include <cs50.h>
#include <ctype.h>
#include <stdio.h>
#include <string.h>

// Points assigned to each letter of the alphabet
int POINTS[] = {
    1, 3, 3, 2, 1, 4, 2, 4, 1, 8,
    5, 1, 3, 1, 1, 3, 10, 1, 1, 1,
    1, 4, 4, 8, 4, 10
};

// Function prototype
int compute_score(string word);

int main(void)
{
    // Prompt Player 1 for a word
    string word1 = get_string("Player 1: ");

    // Prompt Player 2 for a word
    string word2 = get_string("Player 2: ");

    // Compute scores for both players
    int score1 = compute_score(word1);
    int score2 = compute_score(word2);

    // Print the winner or declare a tie
    if (score1 > score2)
    {
        printf("Player 1 wins!\n");
    }
    else if (score2 > score1)
    {
        printf("Player 2 wins!\n");
    }
    else
    {
        printf("Tie!\n");
    }
}

// Function that computes the Scrabble score for a given word
int compute_score(string word)
{
    int score = 0;

    // Loop through each character in the word
    for (int i = 0; i < strlen(word); i++)
    {
        char c = word[i];

        // If it's an uppercase letter
        if (isupper(c))
        {
            score += POINTS[c - 'A'];
        }
        // If it's a lowercase letter
        else if (islower(c))
        {
            score += POINTS[c - 'a'];
        }
        // Ignore any other characters (e.g., punctuation)
    }

    return score;
}
